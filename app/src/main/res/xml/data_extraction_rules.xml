<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12+. See https://developer.android.com/about/versions/12/backup-restore#xml-changes -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Profile photos are device-local for now; keep them out of cloud backups. -->
        <exclude domain="file" path="profile_photos/" />
        <!-- Nutrition profiles are local-only until cloud sync exists. -->
        <exclude domain="file" path="datastore/nutrition_profiles.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="profile_photos/" />
        <!-- Nutrition profiles are local-only until cloud sync exists. -->
        <exclude domain="file" path="datastore/nutrition_profiles.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
